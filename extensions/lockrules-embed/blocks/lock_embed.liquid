{%- comment -%}
  LockRules evaluator. Runs in <head> on every storefront page.

  Reads the compiled config written by app/lib/compile.server.ts to the app-data
  metafield `app.metafields.lockrules.config`, decides whether the current page
  is locked for this visitor, and hands the result to assets/lockrules.js.
  Key checks live in snippets/lr_open.liquid (shared with the app blocks).

  Protect modes (lock.pm):
    page     - hide the page's main content
    commerce - keep the page, hide price and add to cart
    manual   - nothing automatic; only the LockRules app blocks react
  Variant locks never hide a page; they remove the variant from the picker.
{%- endcomment -%}
{%- liquid
  assign cfg = app.metafields.lockrules.config.value
  capture unlocked
    render 'lr_unlocked'
  endcapture
  assign lr_denied = false
  assign lr_commerce = false
  assign lr_idx = -1
  assign lr_act = ''
  assign lr_hide = ''
  assign lr_nav = ''
  assign lr_variants = ''

  assign tpl = template.name
  assign rid = ''
  assign col_ids = '|'
  assign p_vendor = ''
  assign p_tags = '|'
  case tpl
    when 'product'
      assign rid = product.id | append: ''
      assign p_vendor = product.vendor | downcase
      assign p_tags = product.tags | join: '|' | downcase | prepend: '|' | append: '|'
      for col in product.collections
        assign col_ids = col_ids | append: col.id | append: '|'
      endfor
    when 'collection'
      assign rid = collection.id | append: ''
    when 'page'
      assign rid = page.id | append: ''
    when 'blog'
      assign rid = blog.id | append: ''
    when 'article'
      assign rid = article.id | append: ''
      assign blog_id = blog.id | append: ''
  endcase

  for lock in cfg.locks
    assign applies = false
    case lock.type
      when 'store'
        assign applies = true
        if template.directory == 'customers' or tpl == 'password'
          assign applies = false
        elsif tpl == 'index' and lock.ex contains 'home'
          assign applies = false
        elsif tpl == 'page' and lock.ex contains 'pages'
          assign applies = false
        elsif tpl == 'search' and lock.ex contains 'search'
          assign applies = false
        elsif request.path contains '/policies/' and lock.ex contains 'policies'
          assign applies = false
        endif
      when 'product'
        if tpl == 'product' and lock.ids contains rid
          assign applies = true
        endif
      when 'vendor'
        if tpl == 'product' and lock.ids contains p_vendor
          assign applies = true
        endif
      when 'collection', 'product_tag'
        if tpl == 'collection' and lock.type == 'collection' and lock.ids contains rid
          assign applies = true
        elsif tpl == 'product'
          assign haystack = col_ids
          if lock.type == 'product_tag'
            assign haystack = p_tags
          endif
          for lid in lock.ids
            assign needle = '|' | append: lid | append: '|'
            if haystack contains needle
              assign applies = true
              break
            endif
          endfor
        endif
      when 'variant'
        if tpl == 'product'
          for v in product.variants
            assign vid = v.id | append: ''
            if lock.ids contains vid
              assign applies = true
              break
            endif
          endfor
        endif
      when 'page', 'article'
        if tpl == lock.type and lock.ids contains rid
          assign applies = true
        endif
      when 'blog'
        if tpl == 'blog' and lock.ids contains rid
          assign applies = true
        elsif tpl == 'article' and lock.ids contains blog_id
          assign applies = true
        endif
    endcase

    unless applies or lock.hide or lock.nav
      continue
    endunless

    capture open
      render 'lr_open', lock: lock, unlocked: unlocked
    endcapture
    if open != blank
      continue
    endif

    if applies
      if lock.type == 'variant'
        for vid in lock.ids
          assign lr_variants = lr_variants | append: vid | append: ','
        endfor
      elsif lock.pm == 'commerce'
        if lr_commerce == false and lr_denied == false
          assign lr_idx = forloop.index0
        endif
        assign lr_commerce = true
      elsif lock.pm != 'manual' and lr_denied == false
        assign lr_denied = true
        assign lr_idx = forloop.index0
      endif
    endif

    if lock.type == 'product' or lock.type == 'collection' or lock.type == 'page' or lock.type == 'blog'
      assign prefix = '/' | append: lock.type | append: 's/'
      for h in lock.handles
        if lock.hide
          assign lr_hide = lr_hide | append: prefix | append: h | append: ','
        endif
        if lock.nav
          assign lr_nav = lr_nav | append: prefix | append: h | append: ','
        endif
      endfor
    endif
  endfor

  assign lr_msg = ''
  assign lr_url = ''
  assign remote_js = ''
  if lr_idx >= 0
    assign dl = cfg.locks[lr_idx]
    assign lr_act = dl.act
    assign lr_msg = dl.msg
    assign lr_url = dl.url
    if lr_act == 'redirect' and lr_url == blank
      assign lr_act = 'message'
    endif
    if lr_act == 'login' and customer
      assign lr_act = 'message'
    endif
    if lr_commerce and lr_denied == false and lr_act == 'redirect'
      # A commerce lock keeps the page, so it never redirects.
      assign lr_act = 'message'
    endif

    # Prompts the visitor can act on: only ids, types and confirm text, never lock values.
    for key in dl.keys
      for c in key.c
        if c.inv
          continue
        endif
        if c.t == 'passcode' or c.t == 'confirm' or c.t == 'ip'
          assign needle = '|' | append: c.id | append: '|'
          if unlocked contains needle
            continue
          endif
          assign j_id = c.id | json
          assign j_t = c.t | json
          assign j_p = c.p | default: '' | json
          assign remote_js = remote_js | append: '{"id":' | append: j_id | append: ',"t":' | append: j_t | append: ',"p":' | append: j_p | append: '},'
        endif
      endfor
    endfor
  endif

  assign loc = request.locale.iso_code | downcase
  assign tm = cfg.msgs[loc]

  assign login_url = routes.account_login_url
  if login_url contains '?'
    assign login_url = login_url | append: '&'
  else
    assign login_url = login_url | append: '?'
  endif
  assign return_to = request.path | url_encode
  assign login_url = login_url | append: 'return_url=' | append: return_to | append: '&return_to=' | append: return_to
-%}
{%- if lr_denied and lr_act == 'redirect' and remote_js == blank -%}
  <meta http-equiv="refresh" content="0;url={{ lr_url | escape }}">
  <script>
    location.replace({{ lr_url | json }});
  </script>
{%- elsif lr_denied -%}
  <style>
    main, #MainContent, [role='main'] { visibility: hidden !important; }
    .lockrules-denied { visibility: visible !important; }
  </style>
{%- elsif lr_commerce -%}
  <style>
    .product__info-container .price, .product .price, .product-single__price, [data-product-price],
    product-form, .product-form, form[action$='/cart/add'] [type='submit'], .shopify-payment-button,
    .product-form__quantity, quantity-input { display: none !important; }
  </style>
{%- endif -%}
{%- if lr_denied or lr_commerce or lr_hide != blank or lr_nav != blank or lr_variants != blank -%}
  <script>
    window.LockRules = {
      denied: {{ lr_denied | json }},
      commerce: {{ lr_commerce | json }},
      action: {{ lr_act | json }},
      message: {{ lr_msg | json }},
      redirectUrl: {{ lr_url | json }},
      signedIn: {% if customer %}true{% else %}false{% endif %},
      loginUrl: {{ login_url | json }},
      proxy: "/apps/lockrules",
      remote: [{{ remote_js | remove_last: ',' }}],
      hide: {{ lr_hide | split: ',' | json }},
      nav: {{ lr_nav | split: ',' | json }},
      variants: {{ lr_variants | split: ',' | json }},
      t: {
        login: {{ tm.login | default: cfg.msg.login | json }},
        loginButton: {{ tm.loginButton | default: cfg.msg.loginButton | json }},
        denied: {{ tm.denied | default: cfg.msg.denied | json }},
        passcode: {{ tm.passcode | default: cfg.msg.passcode | json }},
        passcodeButton: {{ tm.passcodeButton | default: cfg.msg.passcodeButton | json }},
        passcodeError: {{ tm.passcodeError | default: cfg.msg.passcodeError | json }},
        confirm: {{ tm.confirm | default: cfg.msg.confirm | json }},
        confirmButton: {{ tm.confirmButton | default: cfg.msg.confirmButton | json }}
      }
    };
  </script>
  <script src="{{ 'lockrules.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "LockRules",
  "target": "head",
  "settings": []
}
{% endschema %}
