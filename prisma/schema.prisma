// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Shop {
  id             String    @id @default(cuid())
  domain         String    @unique
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  // Shopify Validation (checkout function owner) we created for this shop
  validationId   String?
  // Storefront-facing defaults: messages, login prompt text, etc.
  settings       Json      @default("{}")
  lastSyncedAt   DateTime?
  syncError      String?
  // Signs unlock tokens; mirrored to an app-data metafield for Liquid and the checkout function.
  hmacSecret     String?
  // Payment customization (payment rules function owner) we created for this shop
  paymentCustomizationId String?
  // Resource gids we set seo.hidden on, so we only ever remove our own
  seoHiddenIds   Json      @default("[]")
  // Secure mode: LockRules code written into the published theme (needs the theme-write exemption)
  secureEnabled  Boolean   @default(false)
  secureThemeId  String?
  // Theme files the merchant excluded from injection, e.g. ["sections/main-collection.liquid"]
  secureExcluded Json      @default("[]")
  // Last install result: { at, themeName, edited: [...], warnings: [...], error? }
  secureReport   Json      @default("{}")
  // Shopify App Pricing plan handle (free | basic | pro), cached from the Partner API
  planHandle     String?
  planCheckedAt  DateTime?
  trialEndsAt    DateTime?
  locks          Lock[]
  inputLists     InputList[]
  keyUsages      KeyUsage[]
  lockStats      LockStat[]
  importJobs     ImportJob[]
  integrations   Integration[]
  apiKeys        ApiKey[]
}

model Lock {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  // product | collection | page | blog | article | store | vendor | product_tag | variant | liquid
  resourceType    String
  // liquid locks: Liquid that outputs "true" on pages the lock covers (secure mode only)
  liquidCode      String?
  // [{ id: "gid://shopify/Product/1", handle: "x", title: "X" }]
  resources       Json     @default("[]")
  enabled         Boolean  @default(true)
  hideFromLists   Boolean  @default(false)
  hideNavLinks    Boolean  @default(false)
  // page: hide the whole page | commerce: hide price + add to cart | sections: hide sectionSelectors | manual: only app blocks
  protect         String   @default("page")
  // protect = sections: CSS selectors of theme sections/blocks to hide, one per line
  sectionSelectors String?
  seoHidden       Boolean  @default(false)
  // message | login | redirect
  deniedAction    String   @default("message")
  deniedMessage   String?
  redirectUrl     String?
  // store lock only: ["home", "policies", "search", "pages"]
  storeExceptions Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  keys            LockKey[]

  @@index([shopId])
}

// Keys are ORed: any one key opens the lock.
model LockKey {
  id         String      @id @default(cuid())
  lockId     String
  lock       Lock        @relation(fields: [lockId], references: [id], onDelete: Cascade)
  position   Int         @default(0)
  conditions Condition[]

  @@index([lockId])
}

// Conditions are ANDed: every condition in a key must pass.
model Condition {
  id       String  @id @default(cuid())
  keyId    String
  key      LockKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  position Int     @default(0)
  // see CONDITION_TYPES in app/lib/locks.ts
  type     String
  // { values, listId?, minutes?, prompt?, code? }
  params   Json    @default("{}")
  inverted Boolean @default(false)

  @@index([keyId])
}

// Bulk passcodes or emails, referenced by conditions through params.listId.
model InputList {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  // passcode | email
  kind      String
  // [{ v: "CODE", r?: "/pages/after-unlock" }]
  entries   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

// One row per successful unlock through the app proxy.
model KeyUsage {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lockId      String?
  conditionId String
  // passcode | secret_link | confirm | ip
  kind        String
  value       String?
  customerId  String?
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, customerId])
}

// Marketing integrations. credentials is AES-GCM encrypted JSON (app/lib/crypto.server.ts).
model Integration {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // klaviyo | mailchimp
  provider    String
  credentials String
  // { doubleOptIn?: boolean }
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, provider])
}

// Keys for the public REST API (/api/v1). Only a SHA-256 hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  // First characters, shown in the admin to tell keys apart
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([shopId])
}

// Daily storefront counters per lock (unique denied sessions), from the app proxy.
model LockStat {
  id      String   @id @default(cuid())
  shopId  String
  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lockId  String
  day     DateTime @db.Date
  denied  Int      @default(0)

  @@unique([shopId, lockId, day])
  @@index([shopId, day])
}

// Bulk customer import (CSV of emails + tags), processed in the background.
model ImportJob {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // queued | running | done | failed
  status    String   @default("queued")
  total     Int      @default(0)
  processed Int      @default(0)
  created   Int      @default(0)
  updated   Int      @default(0)
  // [{ email, tags, firstName?, lastName? }]; cleared when done
  rows      Json     @default("[]")
  errors    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, createdAt])
}
